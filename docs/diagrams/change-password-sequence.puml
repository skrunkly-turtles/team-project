@startuml
title Change Password - Authenticated Use Case
actor User
participant "ChangePasswordView" as View
participant "ChangePasswordController" as Controller
participant "ChangePasswordInteractor" as Interactor
participant "CurrentUserSession" as Session
participant "ChangePasswordUserDataAccessInterface" as DAO
participant "PasswordHasher" as Hash
participant "ChangePasswordPresenter" as Presenter
participant "ProfileViewModel" as ViewModel
User -> View : current/new/confirm passwords
View -> Controller : execute(...)
Controller -> Interactor : execute(ChangePasswordInputData)
Interactor -> Session : getCurrentUsername()
Session --> Interactor : username
Interactor -> DAO : get(username)
DAO --> Interactor : User
Interactor -> Hash : matches(current, hash)
Hash --> Interactor : true
Interactor -> Hash : hash(new password)
Hash --> Interactor : salted hash
Interactor -> DAO : updatePasswordHash(username,hash)
Interactor -> Presenter : prepareSuccessView(output)
Presenter -> ViewModel : setState(username, success message)
@enduml
